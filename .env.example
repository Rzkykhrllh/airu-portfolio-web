# API Backend URL
# For Docker: use backend container name (airu-portfolio-be)
# For local dev: use localhost
# For production with domain: use https://api.yourdomain.com
# For production without domain (IP only): use http://YOUR_VM_IP/api
NEXT_PUBLIC_API_BASE_URL=/api

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX).
# Leave unset to keep analytics fully off (no banner, no script, no cookies).
# Get one at https://analytics.google.com — see spec.md for step-by-step setup.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
